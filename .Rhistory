legend.background = element_rect(
fill = alpha("white", 0.85),
color = "#cccccc",
linewidth = 0.35
),
legend.margin = margin(6, 8, 6, 8)
) +
theme(plot.margin = margin(15, 15, 12, 18)) +
coord_cartesian(clip = "off")
}
